# Umkhandlu GIS & Spatial Intelligence MCP — environment variables
# Copy to .env and fill in real values. Never commit .env.

# ── Control Centre (Unami Platform Core) ─────────────────────────────────────
# Base URL of the deployed Control Centre (no trailing slash).
# Public spatial APIs are called without auth.
# Operator spatial APIs require UMKHANDLU_OPERATOR_TOKEN.
CONTROL_CENTRE_URL=https://unami-platform-core-umkhandlu.vercel.app

# Never place credentials in tracked mcp.json. For local MCP use, store secrets
# in the ignored .env file; for hosted MCP, use the host's protected secret store.

# Operator session token for authenticated Control Centre endpoints
# (spatial/integrity, spatial/probe, etc.).
# Obtain by logging into the Control Centre and copying the session token,
# or generate a long-lived token via the operator settings page.
UMKHANDLU_OPERATOR_TOKEN=

# ── Governance Node (Umkhandlu Sanity) ───────────────────────────────────────
# Sanity project ID and dataset for the Governance Node.
SANITY_PROJECT_ID=60v9eb0r
SANITY_DATASET=production
SANITY_API_VERSION=2026-01-01

# Read-only Sanity token (viewer role).
# Generate at: https://www.sanity.io/manage → project → API → Tokens
SANITY_READ_TOKEN=

# Intelligence API key — issued by the Governance Node to the Control Centre.
# Used by the MCP to call /api/intelligence/* endpoints on the Governance Node.
INTELLIGENCE_API_KEY=

# Governance Node base URL (no trailing slash).
GOVERNANCE_NODE_URL=https://umkhandlu.unamifoundation.org
